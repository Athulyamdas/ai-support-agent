# ─────────────────────────────────────────────
#  AI Customer Support Agent — Environment Config
# ─────────────────────────────────────────────

# ── LLM Provider (choose one) ──────────────────
# Option A: OpenAI
OPENAI_API_KEY=sk-...your-key-here...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Option B: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...your-key-here...
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-haiku-20240307

# ── LLM Settings ───────────────────────────────
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ── Flask ──────────────────────────────────────
FLASK_ENV=development
FLASK_PORT=5000
FLASK_SECRET_KEY=dev-secret-change-in-prod

# ── Storage ────────────────────────────────────
SQLITE_DB_PATH=data/chat_history.db
FAISS_INDEX_PATH=data/faiss_index
MOCK_CRM_PATH=data/mock_crm/customers.json

# ── Agent Settings ─────────────────────────────
MAX_CONVERSATION_HISTORY=20
ESCALATION_THRESHOLD=3        # failed resolution attempts before escalate
CONFIDENCE_THRESHOLD=0.75     # KB retrieval confidence cutoff
